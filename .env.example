# Copernicus Data Space Ecosystem (CDSE) Credentials (Required for SAR Imagery acquisition)
# Register for free at https://dataspace.copernicus.eu/
COP_USERNAME=your_copernicus_email@example.com
COP_PASSWORD=your_copernicus_password

# N2YO Satellite Pass Prediction API Key (Required for pass forecasting)
# Register at https://www.n2yo.com/api/
N2YO_API_KEY=your_n2yo_api_key

# Optional runtime configuration
FLASK_DEBUG=false
PORT=5050
DATABASE_PATH=data.db
OUTPUT_ROOT=static/output
CACHE_ROOT=.cache
